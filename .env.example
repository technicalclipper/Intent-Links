# Copy to .env and fill in. .env is gitignored; never commit real values.
# This repo is public.

# --- Gemini -----------------------------------------------------------------
# AI Studio key (starts with AIza...). https://aistudio.google.com/apikey
GOOGLE_API_KEY=AQ.Ab8RN6IkqgBBFwGM-_D1UVdmiGaK1UFIAyeKcO8aY0YAwKD_dw

# Use Vertex AI instead of the AI Studio key. Needs a GCP project + ADC.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# Pro-tier for compile-time (runs once, quality matters).
# Flash-tier for run-time resolution (per action, latency matters).
INTENTLINK_MODEL_COMPILE=
INTENTLINK_MODEL_RUNTIME=

# --- Policy service ---------------------------------------------------------
# >=32 chars. The service refuses to boot without it; no weak default exists.
# Generate: openssl rand -hex 32
INTENTLINK_TOKEN_SECRET=

# Where the agent reaches the authority.
INTENTLINK_POLICY_URL=http://127.0.0.1:8080
