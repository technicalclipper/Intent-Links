# Copy to .env and fill in. .env is gitignored; never commit real values.
# This repo is public.

# --- Gemini -----------------------------------------------------------------
# AI Studio key (starts with AIza...). https://aistudio.google.com/apikey
GOOGLE_API_KEY=AQ.Ab8RN6IkqgBBFwGM-_D1UVdmiGaK1UFIAyeKcO8aY0YAwKD_dw

# Use Vertex AI instead of the AI Studio key. Needs a GCP project + ADC.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# Compile-time: runs once per IntentLink, quality matters, latency does not.
# Chosen by scripts/evaluate-models.mjs, which scores candidates on the
# judgments that matter (parameter vs literal vs condition) rather than on
# whether the JSON parsed. gemini-3.8-flash scored 6/6 on the first attempt.
#
# Note: Pro models return quota "limit: 0" on the AI Studio free tier, so
# compile-time runs on flash unless billing is enabled. It is not a compromise
# here - flash got every judgment right.
INTENTLINK_MODEL_COMPILE=gemini-3.8-flash

# Run-time: consulted when resolution is ambiguous, so latency is the
# constraint. Measured on a realistic brief (workflow + 40 page candidates),
# three calls each:
#
#   gemini-3.5-flash-lite     995 ms
#   gemini-3.1-flash-lite   1,334 ms
#   gemini-3.8-flash        2,283 ms
#   gemini-3.5-flash        2,543 ms
#
# That is a floor, not a turn: a real turn adds tool-calling round trips.
# Since the fast path handles exact, unambiguous matches without a model at
# all, this is paid only when the page genuinely differs from the recording.
INTENTLINK_MODEL_RUNTIME=gemini-3.5-flash-lite

# --- Policy service ---------------------------------------------------------
# >=32 chars. The service refuses to boot without it; no weak default exists.
# Generate: openssl rand -hex 32
INTENTLINK_TOKEN_SECRET=

# Where the agent reaches the authority.
INTENTLINK_POLICY_URL=http://127.0.0.1:8080
